<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.nsu.shabalina.GameController"
            prefWidth="600" prefHeight="400">
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: rgba(255, 255, 255, 0.8); -fx-padding: 10;">
            <Label fx:id="scoreLabel" text="Score: 0" style="-fx-text-fill: #333; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 2, 2);">
                <font>
                    <Font name="Verdana" size="18"/>
                </font>
            </Label>
            <Label fx:id="stateLabel" text="" style="-fx-text-fill: #333; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 2, 2);">
                <font>
                    <Font name="Verdana" size="18"/>
                </font>
            </Label>
        </VBox>
    </top>
    <center>
        <Canvas fx:id="gameCanvas" width="600" height="360"/>
    </center>
</BorderPane>


